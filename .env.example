POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter
POSTGRES_DB=spotter_freight
POSTGRES_HOST=localhost
# Use 5433 by default to avoid clashing with a local Postgres already on 5432
POSTGRES_PORT=5433

# Full SQLAlchemy URL (used by the ingestion script)
DATABASE_URL=postgresql+psycopg://spotter:spotter@localhost:5433/spotter_freight
